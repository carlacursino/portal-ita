<div id="page-content" role="main">
    <div class="container">
        <div id="content">
            <header class="devider-bottom devider-heavy devider-margin-medium">
                <h1>{{translation.projects._title}}</h1>
            </header>
			{{#if data.projects}}
				<div class="container-out">
					<div class="row">
						<div class="col-md-1"></div>
						<div class="col-md-11">
							<ul class="arrow">
								{{#each data.projects}}
									<li><a href="/{{../language}}/project/{{this._id}}">{{this.name}}</a></li>
								{{/each}}
							</ul>
						</div>
					</div>
					<hr class="devider-margin-medium" />
				</div>
			{{/if}}
        </div>
    </div>
</div>
