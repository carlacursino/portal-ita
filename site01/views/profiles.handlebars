<div id="page-content" role="main">
    <div class="container">
        <header class="devider-bottom devider-heavy devider-margin-medium">
            <h1>{{translation.profiles._title}}</h1>
        </header>
        {{#if data.teachers}}
            <div class="grid-wrap">
                <div class="row">
                    <div class="col-md-3">
                        <div id="content">
                            <div class="title">
                                <h4 class="h4">{{translation.profiles.group.teachers}}</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <section id="projects" class="grid" data-columns="4">
                            {{#each data.teachers}}
                                <article class="project project-animated illustration design">
                                    <div class="project-heading">
                                        <div class="thumbnail">
                                            <a href="/{{../language}}/profile/{{this._id}}">
                                                {{#if this.picture.src}}
                                                    <img src="{{this.picture.src}}">
                                                {{else}}
                                                    <img src="/static/images/icons/client.png">
                                                {{/if}}
                                                <h4 class="highlight">{{this.name}}</h4>
                                                {{#if this.title}}
                                                    <h6 class="networking" style="min-height: 3em;">{{this.title}}</h6>
                                                {{/if}}
                                                {{#if this.institution.description}}
                                                    <h6>{{this.institution.description}}</h6>
                                                {{/if}}
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            {{/each}}
                        </section>
                    </div>
                </div>
            </div>
            <hr class="devider-margin-medium" />
        {{/if}}
        {{#if data.researchers}}
