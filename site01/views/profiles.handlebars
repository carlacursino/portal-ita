<div id="page-content" role="main">
    <div class="container"><div class="container">
        <div id="content">
            <header class="devider-bottom devider-heavy devider-margin-medium">
                <h1>Pessoas</h1>
            </header>
            <div class="grid-wrap"><div class="row">
                <div class="col-md-1"></div>
                <div class="col-md-11">
                    <section id="projects" class="grid" data-columns="4">
                        {{#each data.profiles}}
                            <article class="project project-animated illustration design">
                                <div class="project-heading">
                                    <div class="thumbnail">
                                        {{#if this.picture.src}}
                                            <img src="{{this.picture.src}}">
                                        {{else}}
                                            <img src="/static/images/icons/client.png">
                                        {{/if}}
                                        <p>{{this.name}}</p>
                                    </div>
                                    <ul class="project-action">
                                        <li><a class="link btn btn-icon-link" href="/{{../language}}/profile/{{this._id}}"></a></li>
                                    </ul>
                                </div>
                            </article>
                        {{/each}}
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>
