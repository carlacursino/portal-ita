<div>
    <div class="title">
        <h4>{{translation.partials.navContato.phoneList}}</h4>
    </div>
    <div class="text">
        <p><i>{{translation.partials.navContato._subtitle}}</i></p>
        <p><i>{{translation.partials.phoneList._subtitle}}</i></p>
    </div>
    <hr />
    <div class="row">
        <div class="col-sm-7">
            <table class="table table-striped"><caption>{{translation.partials.phoneList.firstFloor}}</caption>
                <thead>
                    <tr>
                        <th>{{translation.partials.phoneList.room}}</th>
                        <th>{{translation.partials.phoneList.phone}}</th>
                        <th>{{translation.partials.phoneList.person}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each data.contacts}}
                        <tr><td>{{this.room}}</td><td><i class='icomoon-phone'></i>{{this.phone}}</td><td>{{this.name}}</td></tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>
