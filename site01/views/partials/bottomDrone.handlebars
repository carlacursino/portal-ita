<div class="container">
    <div class="row"></div>
    <div class="row-inline-wrap">
        <div class="row row-inline">
            <div class="col-sm-2">
                <div class="widget">
                    <div class="widget-heading">
                        <div class="title title-main">
                            <a href="http://www.cta.br/" class="logo" target="_blank">
                                <img width="50%" src="/static/images/logo-dcta.png" alt="ITA">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <ul class="touch">
                    <li><a href="{{config.portal.ita.localizacao.googleLinkMap}}" target="_blank"><i class="fa icomoon-location"></i></a>
                        <p>{{translation.partials.bottom.street}}<br />{{translation.partials.bottom.complement}}</p>
                    </li>
                    <li><i class="fa fa-phone"></i>
                        <p>{{config.portal.contato.contatos.foneProjeto}}</p>
                    </li>
                    <li><i class="fa fa-envelope"></i>
                        <p><a href="{{config.portal.contato.contatos.mailProjeto}}">{{translation.partials.bottom.contact}}</a></p>
                    </li>
                </ul>
            </div>
            <div class="col-md-2">
                <div class="widget">
                    <div class="widget-heading">
                        <div class="title title-main">
                            <a href="http://fab.mil.br/" class="logo" target="_blank">
                                <img width="75%" src="/static/images/fab-logo.png" alt="ITA">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2"></div>
            <div class="networking col-md-8">
                <ul class="touch">
                    {{#if config.portal.social.github}}
                        <li><a href="{{config.portal.social.github}}" target="_blank"><i class="fa icomoon-github"></i></a></li>
                    {{/if}}
                    {{#if config.portal.social.facebook}}
                        <li><a href="{{config.portal.social.facebook}}" target="_blank"><i class="fa icomoon-facebook"></i></a></li>
                    {{/if}}
                    {{#if config.portal.social.linkedin}}
                        <li><a href="{{config.portal.social.linkedin}}" target="_blank"><i class="fa icomoon-linkedin"></i></a></li>
                    {{/if}}
                    {{#if config.portal.social.youtube}}
                        <li><a href="{{config.portal.social.youtube}}" target="_blank"><i class="fa icomoon-youtube"></i></a></li>
                    {{/if}}
                </ul>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
</div>