{{#gt this.posts.length 0}}
    {{#each this.posts}}
        <article class="project project-default photography">
            <div class="project-heading">
                <div class="thumbnail">
                    <div class="media-wrapper">
                        {{#unless this.video}}
                            {{#if this.route}}
                                <a class="link" href="/{{../language}}{{this.route}}">
                                    <span class="btn btn-icon-link"></span>
                            {{else}}
                                {{#if this.link}}
                                    <a class="link" href="BBB{{this.link}}" target="_blank">
                                        <span class="btn btn-icon-link"></span>
                                {{else}}
                                    <a class="link" href="/{{../language}}/post/{{this.slug}}">
                                        <span class="btn btn-icon-link"></span>
                                {{/if}}
                            {{/if}}
                        {{/unless}}
                        {{#if this.image.src}}
                            <img src="{{this.image.src}}" alt="{{this.title}}">
                        {{else}}
                            {{#if this.video}}
                                <iframe height="100%" src="{{this.video}}" frameborder="0" allow="fullscreen"></iframe>
                            {{else}}
                                {{#if this.content.brief}}
                                    <p>{{{this.content.brief}}}</p>
                                {{else}}
                                    <h2>{{this.title}}</h2>
                                {{/if}}
                            {{/if}}
                        {{/if}}
                        {{#unless this.video}}
                            <div class="overlay-title"><h3>{{this.title}}</h3></div>
                            </a>
                        {{/unless}}
                    </div>
                </div>
            </div>
        </article>
    {{/each}}
{{/gt}}