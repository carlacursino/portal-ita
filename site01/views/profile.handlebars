<div id="page-content" role="main">
	<div class="container"><div class="container">
		<div id="content">
			<div class="container-out container-light">
				<div class="row">
					<div class="col-md-3">
						<div id="content">
							{{#if data.profile.picture}}
								<img src="{{data.profile.picture.src}}">
							{{/if}}
						</div>
					</div>
					<div class="col-md-6">
						<div id="content">
							<div class="title">
								<h2 class="h3">{{data.profile.name}}</h2>
								<h3 class="h4">{{data.profile.title}}</h3>
							</div>
							<div class="text">
								{{data.profile.curriculum.md}}
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-md-3"></div>
					<div class="col-md-6">
						<div id="content">
							<div class="row-inline-wrap">
								<div class="row row-inline">
									<div class="col-sm-9">
										<ul class="social">
											{{#if data.profile.cv}}
												<li><a href="{{data.profile.cv}}" class="cv"></a></li>
											{{/if}}
											{{#if data.profile.email}}
												<li><a href="{{data.profile.email}}" class="email"></a></li>
											{{/if}}
											{{#if data.profile.scholar}}
												<li><a href="{{data.profile.scholar}}" class="google"></a></li>
											{{/if}}
											{{#if data.profile.vcs}}
												<li><a href="{{data.profile.vcs}}" class="github"></a></li>
											{{/if}}
											{{#if data.profile.lattes}}
												<li><a href="{{data.profile.lattes}}" class="lattes"></a></li>
											{{/if}}
											{{#if data.profile.orcid}}
												<li><a href="{{data.profile.orcid}}" class="orcid"></a></li>
											{{/if}}
											{{#if data.profile.linkedin}}
												<li><a href="{{data.profile.linkedin}}" class="linkedin"></a></li>
											{{/if}}
											{{#if data.profile.youtube}}
												<li><a href="{{data.profile.youtube}}" class="youtube"></a></li>
											{{/if}}
										</ul>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			{{#if data.projects}}
				<div class="container-out">
					<div class="row">
						<div class="col-sm-12">
							<div class="title title-section">
								<h2>Projetos</h2>
								<span class="sticker">
									<i class="icon icomoon-stats"></i>
								</span>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-9">
							<div id="content">
								<ul class="arrow">
									{{#each data.projects}}
										<li><a href="/{{../language}}/project/{{this._id}}">{{this.name}}</a></li>
									{{/each}}
								</ul>
							</div>
						</div>
					</div>
					<hr class="devider-margin-medium" />
				</div>
			{{/if}}
		</div>
	</div></div>
</div>
