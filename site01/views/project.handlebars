<div id="page-content" role="main">
    <div class="container">
		<div class="container-out">
			<div class="row">
				<div class="col-md-12">
					<div class="title">
						<h2 class="h2">{{data.project.name}}</h2>
						<p>{{{data.project.description}}}</p>
					</div>
				</div>
			</div>
			{{#if data.project.researchers}}
				<div class="row">
					<div class="col-md-3">
						<div class="title">
							<h4 class="h4">{{translation.project.researchers}}</h4>
						</div>
					</div>
					<div class="col-md-9">
						<ul class="arrow">
							{{#each data.project.researchers}}
								{{#if this.active}}
									<li><a href="/{{../language}}/profile/{{this._id}}">{{this.name}}</a>
										<ul class="social">
											{{#if this.cv}}
												<li><a href="{{this.cv}}" class="home"></a></li>
											{{/if}}
											{{#if this.email}}
												<li><a href="mailto:{{this.email}}" class="email"></a></li>
											{{/if}}
											{{#if this.scholar}}
												<li><a href="{{this.scholar}}" class="scholar"></a></li>
											{{/if}}
											{{#if this.vcs}}
												<li><a href="{{this.vcs}}" class="github"></a></li>
											{{/if}}
											{{#if this.lattes}}
												<li><a href="{{this.lattes}}" class="lattes"></a></li>
											{{/if}}
											{{#if this.orcid}}
												<li><a href="{{this.orcid}}" class="orcid"></a></li>
											{{/if}}
											{{#if this.linkedin}}
												<li><a href="{{this.linkedin}}" class="linkedin"></a></li>
											{{/if}}
											{{#if this.instagram}}
												<li><a href="{{this.instagram}}" class="instagram"></a></li>
											{{/if}}
											{{#if this.youtube}}
												<li><a href="{{this.youtube}}" class="youtube"></a></li>
											{{/if}}
										</ul></li>
								{{else}}
									<li>this.name</li>
								{{/if}}
							{{/each}}
						</ul>
					</div>
					<hr class="devider-margin-medium" />
				</div>
			{{/if}}
			{{#if data.publications}}
				<div class="row">
					<div class="col-md-3">
						<div class="title">
							<h4 class="h4">{{translation.project.publications}}</h4>
						</div>
					</div>
					<div class="col-md-9">
						<ul class="arrow">
							{{#each data.publications}}
								<li><a href="/{{../language}}/publication/{{this._id}}">{{this.title}}</a>
								<ul class="social">
									{{#if this.cite}}
										<li><a href="#" class="bibtex" cite-title="{{this.title}}" cite-data="{{this.cite}}"></a></li>
									{{/if}}
									{{#if this.link}}
										<li><a href="{{this.link}}" class="url"></a></li>
									{{/if}}
									{{#if this.doi}}
										<li><a href="{{this.doi}}" class="doi"></a></li>
									{{/if}}
									{{#if this.dataset}}
										<li><a href="{{this.dataset}}" class="dataset"></a></li>
									{{/if}}
									{{#if this.video}}
										<li><a href="{{this.video}}" class="video"></a></li>
									{{/if}}
									{{#if this.file.src}}
										<li><a href="{{this.file.src}}" class="pdf"></a></li>
									{{/if}}
								</ul></li>
							{{/each}}
						</ul>
					</div>
					<hr class="devider-margin-medium" />
				</div>
			{{/if}}
			{{#if data.news}}
				<div class="container-in">
					<div class="row">
						<div class="col-md-3">
							<div class="title">
								<h4 class="h4">{{translation.partials.postsList._title}}</h4>
							</div>
						</div>
						<div class="col-md-9">
							<ul class="arrow">
								{{#each data.news}}
									<li><a class="link" href="/{{../language}}/post/{{this.slug}}">{{this.title}}</a></li>
								{{/each}}
							</ul>
						</div>
					</div>
					<hr class="devider-margin-medium" />
				</div>
			{{/if}}

            {{> publicFiles}}
            
		</div>
	</div>
</div>
