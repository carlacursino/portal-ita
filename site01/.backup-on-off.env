BACKUP_COMPRESSION="gz"
GZIP_PARALLELISM="1"
BACKUP_FILENAME="backup-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_FILENAME_EXPAND="true"
BACKUP_LATEST_SYMLINK=""
BACKUP_FROM_SNAPSHOT="false"
BACKUP_SOURCES="/backup"
BACKUP_EXCLUDE_REGEXP=""
BACKUP_SKIP_BACKENDS_FROM_PRUNE=""
BACKUP_ARCHIVE="/archive"
BACKUP_RETENTION_DAYS="-1"
BACKUP_PRUNING_LEEWAY="1h"
BACKUP_PRUNING_PREFIX="backup"
NOTIFICATION_URLS="smtp://dronecomp:Dronec0mp-it%40@smtp.ita.br:587/?fromAddress=no-reply@ita.br&toAddresses=carlacursino@ita.br"
NOTIFICATION_LEVEL="info"