FROM node:22.19-alpine3.22

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG PORT=3000
ARG ECOSYSTEM=portal
ENV ECOSYSTEM=${ECOSYSTEM}
ENV TZ=America/Sao_Paulo

EXPOSE ${PORT}

RUN apk add --no-cache tzdata git openssh && \
    cp /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    addgroup -g ${GROUP_ID} portal && \
    adduser -u ${USER_ID} -G portal -s /bin/sh -D portal

RUN npm i pm2 -g

WORKDIR /app

COPY package.json package-lock.json ./
COPY site01 ./site01
COPY capstone-accesscontrol ./capstone-accesscontrol
COPY capstone-auth ./capstone-auth
COPY capstone-email ./capstone-email
COPY capstone-file-manager ./capstone-file-manager
COPY capstone-intl ./capstone-intl
COPY capstone-tinymce ./capstone-tinymce
COPY CapstoneJS ./CapstoneJS

RUN mkdir -p /app/node_modules && chown -R portal:portal /app

USER portal

COPY --chown=portal:portal . .

RUN npm i --legacy-peer-deps --no-audit && \
    npm run build && \
    npm prune --omit=dev --legacy-peer-deps

WORKDIR /app/site01

USER portal

RUN cp -r /app/site01/assets/default /app/site01/assets/static
RUN if [ -d "/app/site01/assets/${ECOSYSTEM}" ]; then \
        cp -r /app/site01/assets/${ECOSYSTEM}/. /app/site01/assets/static/; \
    fi

CMD pm2-runtime start ecosystem.config.js --env ${ECOSYSTEM}
