
  backup:
    image: offen/docker-volume-backup:latest
    restart: always
    env_file: ./backup.env
    volumes:
      - mongodata:/backup/mongobackup:ro
      - portaldata:/backup/portalbackup:ro
      - certbotcerts:/backup/certbotcerts:ro
      - certbotchallenges:/backup/certbotchallenges:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
